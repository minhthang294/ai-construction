[Unit]
Description=AI Construction API
After=network.target

[Service]
User=ai-construction
Group=ai-construction
WorkingDirectory=/opt/ai-construction/current/backend
EnvironmentFile=/etc/ai-construction/app.env
ExecStart=/opt/ai-construction/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-construction

[Install]
WantedBy=multi-user.target
